{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "opportunities.schema.json",
  "title": "Opportunities",
  "type": "object",
  "required": ["market", "opportunities", "updated_at"],
  "properties": {
    "market": { "type": "string" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "what", "why_now", "mvp_7_days", "mvp_30_days", "first_10_clients", "launch_score", "scale_score", "founder_fit", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "what": { "type": "string", "minLength": 20 },
          "why_now": { "type": "string", "minLength": 20 },
          "pain_ids": { "type": "array", "items": { "type": "string" } },
          "workflow_steps": { "type": "array", "items": { "type": "string" } },
          "mvp_7_days": { "type": "string", "minLength": 20 },
          "mvp_30_days": { "type": "string", "minLength": 20 },
          "first_10_clients": { "type": "string", "minLength": 20, "description": "как получить первых клиентов каналами основателя" },
          "launch_score": { "$ref": "#/definitions/score" },
          "scale_score": { "$ref": "#/definitions/score" },
          "founder_fit": {
            "type": "object",
            "required": ["pluses", "minuses"],
            "properties": {
              "pluses": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "minuses": { "type": "array", "items": { "type": "string" } }
            }
          },
          "risks": { "type": "array", "items": { "type": "string" } },
          "competitors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "note"],
              "properties": {
                "name": { "type": "string" },
                "note": { "type": "string" },
                "url": { "type": "string", "pattern": "^https?://" }
              }
            }
          },
          "test_plan_7_days": {
            "type": "object",
            "properties": {
              "offer": { "type": "string" },
              "landing": { "type": "string" },
              "channels": { "type": "array", "items": { "type": "string" } },
              "budget": { "type": "string" },
              "success_criteria": { "type": "string" }
            }
          },
          "status": { "enum": ["candidate", "testing", "tested-ok", "tested-fail", "rejected"] }
        }
      }
    }
  },
  "definitions": {
    "score": {
      "type": "object",
      "required": ["total", "components"],
      "properties": {
        "total": { "type": "integer", "minimum": 0, "maximum": 100 },
        "components": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["name", "score", "weight", "why"],
            "properties": {
              "name": { "type": "string" },
              "score": { "type": "integer", "minimum": 0, "maximum": 10 },
              "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "why": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    }
  }
}
