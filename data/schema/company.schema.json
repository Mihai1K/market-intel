{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "company.schema.json",
  "title": "Company",
  "type": "object",
  "required": ["id", "name", "website", "segment", "updated_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "legal_name": { "type": "string" },
    "inn": { "type": "string" },
    "website": { "type": "string" },
    "founded": { "type": "integer" },
    "segment": { "type": "string" },
    "description": { "type": "string" },
    "revenue": { "type": "array", "items": { "$ref": "fact.schema.json" } },
    "net_profit": { "type": "array", "items": { "$ref": "fact.schema.json" } },
    "headcount": { "type": "array", "items": { "$ref": "fact.schema.json" } },
    "disclosed_metrics": {
      "type": "array",
      "description": "MAU/GMV и т.п. — ТОЛЬКО если компания раскрыла сама",
      "items": {
        "allOf": [{ "$ref": "fact.schema.json" }],
        "properties": { "metric": { "type": "string" } },
        "required": ["metric"]
      }
    },
    "pricing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plan", "price", "source_url", "retrieved_at"],
        "properties": {
          "plan": { "type": "string" },
          "price": { "type": "string" },
          "source_url": { "type": "string", "pattern": "^https?://" },
          "retrieved_at": { "type": "string" }
        }
      }
    },
    "review_rating": {
      "type": "object",
      "properties": {
        "rating": { "type": "number" },
        "scale": { "type": "string" },
        "count_note": { "type": "string" },
        "source_url": { "type": "string", "pattern": "^https?://" },
        "retrieved_at": { "type": "string" }
      },
      "required": ["rating", "source_url"]
    },
    "top_complaints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["complaint", "source_url"],
        "properties": {
          "complaint": { "type": "string" },
          "source_url": { "type": "string", "pattern": "^https?://" }
        }
      }
    },
    "vacancies_now": { "$ref": "fact.schema.json" },
    "funding": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event", "source_url"],
        "properties": {
          "event": { "type": "string" },
          "date": { "type": "string" },
          "source_url": { "type": "string", "pattern": "^https?://" }
        }
      }
    },
    "ai_readiness": {
      "type": "object",
      "description": "Только из наблюдаемых сигналов, каждый с evidence_url",
      "required": ["score", "signals", "formula"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "formula": { "type": "string" },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["signal", "evidence_url", "direction"],
            "properties": {
              "signal": { "type": "string" },
              "evidence_url": { "type": "string", "pattern": "^https?://" },
              "direction": { "enum": ["+", "-"] }
            }
          }
        }
      }
    },
    "data_gaps": { "type": "array", "items": { "type": "string" }, "description": "что искали, но нет в открытых источниках" },
    "sources": { "type": "array", "items": { "type": "string" } },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
