{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fact.schema.json",
  "title": "Fact",
  "description": "Единственный допустимый способ хранить значимое число. Число без source_url — баг.",
  "type": "object",
  "required": ["value", "unit", "period", "source_name", "source_url", "retrieved_at", "confidence", "method"],
  "properties": {
    "value": { "type": "number" },
    "unit": { "type": "string", "minLength": 1 },
    "period": { "type": "string", "minLength": 1 },
    "basis": { "type": "string", "description": "РСБУ | МСФО | оценка <кого> | самораскрытие" },
    "scope": { "type": "string" },
    "source_name": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "pattern": "^https?://" },
    "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "confidence": { "enum": ["high", "medium", "low"] },
    "method": { "enum": ["reported", "estimated", "derived"] },
    "formula": { "type": "string", "description": "обязательна при method=derived" },
    "note": { "type": "string" },
    "superseded": { "type": "boolean", "description": "true = значение пересмотрено более новым фактом за тот же период; старый факт не удаляется — это история" }
  },
  "if": { "properties": { "method": { "const": "derived" } } },
  "then": { "required": ["formula"] }
}
