{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "market.schema.json",
  "title": "Market",
  "type": "object",
  "required": ["id", "name", "description", "segments", "market_size_rf", "updated_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "scope_assumptions": { "type": "array", "items": { "type": "string" } },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "market_size_rf": {
      "type": "object",
      "description": "Только вилка из 2+ независимых оценок",
      "required": ["estimates"],
      "properties": {
        "estimates": { "type": "array", "minItems": 2, "items": { "$ref": "fact.schema.json" } },
        "range_note": { "type": "string" }
      }
    },
    "market_size_global": {
      "type": "object",
      "properties": {
        "estimates": { "type": "array", "items": { "$ref": "fact.schema.json" } },
        "range_note": { "type": "string" }
      }
    },
    "growth": { "type": "array", "items": { "$ref": "fact.schema.json" } },
    "buying_power": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment", "typical_budget", "ease_of_purchase"],
        "properties": {
          "segment": { "type": "string" },
          "typical_budget": { "type": "string" },
          "deal_cycle": { "type": "string" },
          "ease_of_purchase": { "type": "integer", "minimum": 1, "maximum": 5 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["note", "source_url"],
              "properties": {
                "note": { "type": "string" },
                "source_url": { "type": "string", "pattern": "^https?://" }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "event", "source_url"],
        "properties": {
          "date": { "type": "string" },
          "event": { "type": "string" },
          "source_url": { "type": "string", "pattern": "^https?://" }
        }
      }
    },
    "sources": { "type": "array", "items": { "type": "string" } },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
