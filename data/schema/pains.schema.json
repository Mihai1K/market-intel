{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pains.schema.json",
  "title": "Pains",
  "type": "object",
  "required": ["market", "pains", "updated_at"],
  "properties": {
    "market": { "type": "string" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "pains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "role", "mentions_found", "links", "search_period", "difficulty"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "statement": { "type": "string", "minLength": 10 },
          "role": { "enum": ["соискатель", "рекрутер", "работодатель", "клиент", "владелец", "менеджер"] },
          "mentions_found": { "type": "integer", "minimum": 1, "description": "честный счётчик: сколько упоминаний реально нашли" },
          "links": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https?://" } },
          "search_period": { "type": "string" },
          "who_pays_now": { "type": "string", "description": "кто и сколько платит за решение сейчас; 'неизвестно' если не нашли" },
          "why_unsolved": { "type": "string" },
          "automatable": { "type": "boolean" },
          "ai_possible": { "type": "boolean" },
          "saas_possible": { "type": "boolean" },
          "channel": { "type": "array", "items": { "enum": ["telegram", "whatsapp", "api", "web", "extension"] } },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
          "quotes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "source_url"],
              "properties": {
                "text": { "type": "string", "maxLength": 160 },
                "source_url": { "type": "string", "pattern": "^https?://" }
              }
            }
          }
        }
      }
    },
    "surveys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "source_name", "source_url"],
        "properties": {
          "finding": { "type": "string" },
          "source_name": { "type": "string" },
          "source_url": { "type": "string", "pattern": "^https?://" },
          "period": { "type": "string" }
        }
      }
    }
  }
}
